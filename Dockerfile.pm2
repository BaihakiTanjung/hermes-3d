# Dockerfile for running Hermes3D UI via PM2-runtime (PID 1 container friendly).
FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev

FROM node:22-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_GATEWAY_URL=ws://127.0.0.1:9119
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOST=0.0.0.0

# Install PM2 globally for production process management & container health monitoring
RUN npm install -g pm2 && npm cache clean --force

# Copy build artifacts, custom server, and dependencies
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/server ./server
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.ts ./next.config.ts
COPY ecosystem.config.js ./ecosystem.config.js

# Ensure non-root node user has ownership
RUN chown -R node:node /app
USER node

EXPOSE 3000

# pm2-runtime acts as PID 1, forwards signals, streams stdout/stderr to container logs
CMD ["pm2-runtime", "start", "ecosystem.config.js", "--only", "hermes3d-ui"]
